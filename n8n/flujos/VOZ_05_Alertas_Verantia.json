        "method": "POST",
        "url": "={{ $('Configuración').first().json.WHATSAPP_API_URL + \"/\" + $('Configuración').first().json.WHATSAPP_API_VERSION + \"/\" + $('Configuración').first().json.WHATSAPP_PHONE_NUMBER_ID + \"/messages\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.destino.replace('+', ''), type: 'template', template: { name: $json.plantilla, language: { code: $json.idioma }, components: [{ type: 'body', parameters: $json.parametros.map(t => ({ type: 'text', text: t })) }] } }) }}",
        "options": {
          "timeout": 10000
        }
      },
