        "method": "POST",
        "url": "https://cvbmsdliucawhzmzyylp.supabase.co/rest/v1/rpc/fn_voz_tool",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_raw: $json.p_raw, p_signature: $json.p_signature, p_tool: $json.p_tool, p_to: $json.p_to, p_from: $json.p_from, p_call_id: $json.p_call_id }) }}",
        "options": {
          "timeout": 4000
        }
      },
